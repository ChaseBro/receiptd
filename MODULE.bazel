"""receiptd — the Star thermal-printer CLI and daemon as a Bazel module.

Builds and tests the Go code with rules_go; BUILD files in the Go packages are
generated by Gazelle (`bazel run //:gazelle`) from the sources and go.mod, so
`go build`, `go test`, `make` and the Dockerfile stay the primary path and
Bazel is additive. Depended on by notes, whose Repositories/receiptd page (and
every page linking it) is a target over this repo's `:files`.
"""

module(name = "receiptd")

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

# go.mod's `go 1.24.0` is the language floor, which the Dockerfile's
# golang:1.24 image meets; Bazel needs a newer SDK because the Go modules
# rules_go and Gazelle themselves build from (golang.org/x/sync v0.23.0, via
# rules_go) require go >= 1.26.
#
# The archives are pinned by hash so no fetch asks go.dev for its version list:
# a pinned download is served from Bazel's repository cache (and the sandbox
# seed), which matters to notes too — loading any module that uses rules_go
# and Gazelle needs an SDK, and this is the one it picks.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    sdks = {
        "darwin_amd64": ("go1.26.11.darwin-amd64.tar.gz", "394baae971332f2bc783d6e2004ae57101479bd3b06ed8209a3fe3570d4ce498"),
        "darwin_arm64": ("go1.26.11.darwin-arm64.tar.gz", "e3a42e67a7a8acf450ebada2b074c7ca863000ca514907b7185b45e8f5cdff57"),
        "linux_amd64": ("go1.26.11.linux-amd64.tar.gz", "9849f4e04ee35303714e34fbc3ac8ab44ea3e448a95aa182f91e3b9b79c710ec"),
        "linux_arm64": ("go1.26.11.linux-arm64.tar.gz", "6c2f29b458b5add0835f18b776f69c8881a6d88428f1484a6da55755e620757e"),
    },
    version = "1.26.11",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_chromedp_chromedp",
    "com_github_makeworld_the_better_one_dither_v2",
    "com_github_rs_zerolog",
    "com_github_spf13_cobra",
    "org_modernc_sqlite",
)
