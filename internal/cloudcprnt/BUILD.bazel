load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//:srcs.bzl", "srcs_filegroup")

go_library(
    name = "cloudcprnt",
    srcs = [
        "client.go",
        "dispatcher.go",
    ],
    importpath = "github.com/ChaseBro/receiptd/internal/cloudcprnt",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/cputil",
        "//internal/jobs",
    ],
)

go_test(
    name = "cloudcprnt_test",
    srcs = ["client_test.go"],
    embed = [":cloudcprnt"],
    # an httptest server on 127.0.0.1; left out of the default run (see .bazelrc)
    tags = ["local-port"],
)

srcs_filegroup()
