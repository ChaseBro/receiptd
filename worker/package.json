{
  "name": "receiptd-worker",
  "version": "0.0.1",
  "private": true,
  "description": "CloudPRNT edge proxy for receiptd (Cloudflare Worker)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "deploy:staging": "npm test && wrangler deploy --env staging",
    "smoke:staging": "NODE_USE_ENV_PROXY=1 CPRNT_URL=${CPRNT_URL:-https://receiptd-cprnt-staging.minigeek.workers.dev} LEGACY_KV_WINDOW_SEC=120 node scripts/dq-smoke.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
